{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "input.submit": "ctrl+return,alt+return",
    "input.newline": "return,shift+return,ctrl+j"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "medium"
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "mode": "auto",
    "indicators": "numbers"
  },
  "prompt": {
    "image_preview": true
  }
}
